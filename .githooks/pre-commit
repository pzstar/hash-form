#!/usr/bin/env bash
#
# Blocks a commit that would introduce a PHP syntax error.
#
# Only the staged files, deliberately: linting the whole tree would fail on
# pre-existing breakage unrelated to the commit in hand, and a hook that
# always fails is a hook that gets turned off.
#
# Written for bash 3.2, which is what macOS ships - no mapfile, no arrays.
set -uo pipefail

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.php')

# Guarded rather than piped straight into xargs: BSD xargs runs the utility
# once even with empty input, which would lint the entire tree.
if [ -z "$staged" ]; then
    exit 0
fi

printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 "$root/.githooks/lint"
